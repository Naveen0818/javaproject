import requests
from requests.auth import HTTPBasicAuth

# CONFIGURE THESE
BLACKDUCK_URL = "https://usbank.xpac.blackduck.com"
USERNAME = "your_blackduck_username"
TOKEN = "your_ui_generated_access_token"  # NOT a bearer token!

# API endpoint to fetch projects
url = f"{BLACKDUCK_URL}/api/projects"

# Basic Auth with token as password
response = requests.get(url, auth=HTTPBasicAuth(USERNAME, TOKEN), headers={"Accept": "application/json"})

if response.status_code == 200:
    projects = response.json().get("items", [])
    for project in projects:
        print(f"- {project['name']} (version: {project.get('versionName')})")
else:
    print(f"❌ Error {response.status_code}: {response.text}")
